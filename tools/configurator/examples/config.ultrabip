vario_tones_freq_4=513
vario_tones_duration_4=770
vario_tones_duty_4=26
vario_tones_vz_5=120
vario_tones_freq_5=675
vario_tones_duration_5=500
vario_tones_duty_5=27
vario_tones_vz_6=300
