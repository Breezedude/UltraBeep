#=============================================================================
# Example configuration (stock format) for testing the configurator
#=============================================================================

[profile1]
enabled_bool=true

identity_profilename_string=paragliding
identity_pilotname_string=Example Pilot
identity_birthdate_string=
identity_wingname_string=Example Wing 1
identity_notes_string=
identity_compid_string=

vario_preset_string=custom
vario_liftstart_int=10
vario_sinkalarm_bool=true
vario_sinkstart_int=-250
vario_liftysound_bool=true
vario_integrationtime_int=25
vario_groundsilent_bool=true
vario_sweeptone_bool=true

bluetooth_enable_bool=true
bluetooth_remoteenable_bool=false
bluetooth_compatibility_bool=false

voicetap_enable_bool=true
voicetap_speed_bool=true
voicetap_altitude_bool=true
voicetap_heading_bool=false
voicetap_climbrate_bool=true
voicetap_time_bool=false
voicetap_duration_bool=true
voicetap_enablewhensilent_bool=false
voicetap_enablebeforetakeoff_bool=false

voiceauto_enable_bool=true
voiceauto_speed_bool=true
voiceauto_altitude_bool=true
voiceauto_heading_bool=false
voiceauto_climbrate_bool=true
voiceauto_time_bool=false
voiceauto_duration_bool=true
voiceauto_altitudetrigger_int=100
voiceauto_distancetrigger_int=1000
voiceauto_timetrigger_int=15

gps_enable_bool=true
gps_takeoffdetection_bool=true

alarm_min2_int=0
alarm_max2_int=0

flightsummary_enable_bool=true
flightsummary_altitude_bool=true
flightsummary_speed_bool=true
flightsummary_climbrate_bool=true
flightsummary_duration_bool=true

led_userled_int=0

system_language_string=de
system_timezoneauto_bool=true
system_timeoffsetminutes_int=60
system_tapsensitivity_int=2
system_autopowerofftime_int=30
system_voicepackversion_string=2023-04-25

vario_tones_vz_0=-500
vario_tones_freq_0=62
vario_tones_duration_0=450
vario_tones_duty_0=50
vario_tones_vz_1=-350
vario_tones_freq_1=75
vario_tones_duration_1=450
vario_tones_duty_1=100
