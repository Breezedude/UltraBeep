# Copy to .env; every line is optional (the defaults are shown).
HOST=127.0.0.1
PORT=5055
# A voice line is a few words: longer texts are refused.
MAX_CHARS=80
# Requests per client IP per window (cache hits do not count). A whole voice pack from the
# configurator is about 1000 requests: 3000 per hour lets a pack be made twice.
RATE_LIMIT=3000
RATE_WINDOW_S=3600
# Use X-Forwarded-For from nginx for the client IP.
TRUST_PROXY=1
# Browser origins allowed to call the relay: * or a comma-separated list, e.g.
# https://ultrabip.breezedude.de,http://localhost:8765
ALLOWED_ORIGINS=*
# Only voices whose name matches this regular expression (empty: all Edge voices).
VOICE_FILTER=^(de|en|fr|it|es|nl|pt|pl|cs|sv|da|nb|fi|hu|sl|sk|hr|ro|tr|ja|el|zh|lv|ko|ru)-
DEFAULT_VOICE=de-DE-KatjaNeural
# Spoken results kept in memory for repeated tries (a whole pack fits, so building it again is free).
CACHE_ENTRIES=2000
UPSTREAM_TIMEOUT_MS=15000
