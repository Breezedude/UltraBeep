# Copy to .env; every line is optional (the defaults are shown).
HOST=127.0.0.1
PORT=5055
# A voice line is a few words: longer texts are refused.
MAX_CHARS=80
# Requests per client IP per window (cache hits do not count). A whole voice pack from the
# configurator is about 1000 requests: 3000 per hour lets a pack be made twice.
RATE_LIMIT=3000
RATE_WINDOW_S=3600
# Use X-Forwarded-For from nginx for the client IP.
TRUST_PROXY=1
# Browser origins allowed to call the relay: * or a comma-separated list, e.g.
# https://ultrabip.breezedude.de,http://localhost:8765
ALLOWED_ORIGINS=*
# Only voices whose name matches this regular expression (empty: all Edge voices).
VOICE_FILTER=^(de|en|fr|it|es|nl|pt|pl|cs|sv|da|nb|fi|hu|sl|sk|hr|ro|tr|ja|el|zh|lv|ko|ru)-
DEFAULT_VOICE=de-DE-KatjaNeural
# Spoken results kept in memory for repeated tries (a whole pack fits, so building it again is free).
CACHE_ENTRIES=2000
UPSTREAM_TIMEOUT_MS=15000
# 0: no Edge voices (only a worker's).
EDGE=1

# The TTS worker at home (tools/tts-worker): the secret it connects with (at least 16 characters,
# e.g. `openssl rand -hex 32`; the same in its /etc/tts/worker.env). Empty: no worker.
WORKER_SECRET=
# A request waits this long for a worker clip, then gets 503 + Retry-After (nginx stops at 30 s);
# the clip is made anyway and comes from the cache when the configurator asks again.
WORKER_WAIT_MS=25000
WORKER_JOB_TIMEOUT_MS=180000
WORKER_QUEUE_MAX=300
# Own voices (cloned from a recording): uploads per IP and day, bytes per recording.
OWN_VOICE_LIMIT=10
OWN_VOICE_MAX_BYTES=2000000
# Voice templates and shared packs per IP and day; bytes per pack (a whole pack is about 16 MB).
TEMPLATE_LIMIT=5
PACK_LIMIT=5
PACK_MAX_BYTES=41943040
# The database of the shared packs (their files are kept by the worker).
DB_PATH=data/relay.db
# The operator's key for listing and deleting shared packs (the worker's lab uses it; at least 16
# characters, e.g. `openssl rand -hex 32`). Empty: no admin API.
ADMIN_TOKEN=
