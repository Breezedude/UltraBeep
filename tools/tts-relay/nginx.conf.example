# voice.breezedude.de -> tts-relay on 127.0.0.1:5055
# In the http {} context (e.g. /etc/nginx/conf.d/tts-relay-zone.conf):
#   limit_req_zone $binary_remote_addr zone=tts:1m rate=30r/m;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name voice.breezedude.de;

    # ssl_certificate     /etc/letsencrypt/live/voice.breezedude.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/voice.breezedude.de/privkey.pem;

    client_max_body_size 8k;

    location / {
        limit_req zone=tts burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name voice.breezedude.de;
    return 301 https://$host$request_uri;
}
