# voice.breezedude.de -> tts-relay on 127.0.0.1:5055
# In the http {} context (e.g. /etc/nginx/conf.d/tts-relay-zone.conf):
#   limit_req_zone $binary_remote_addr zone=tts:1m rate=30r/m;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name voice.breezedude.de;

    # ssl_certificate     /etc/letsencrypt/live/voice.breezedude.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/voice.breezedude.de/privkey.pem;

    client_max_body_size 8k;

    location / {
        limit_req zone=tts burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    # The TTS worker at home: a WebSocket that stays open (the relay pings every 30 s).
    location = /v1/worker {
        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Uploads: recordings for own voices (up to 20 s of 16-bit WAV, about 1 MB) and the 1 MB parts
    # of shared packs; the pack downloads take this way too.
    location ~ ^/v1/(voices/own|packs/[a-z0-9]+/file)$ {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name voice.breezedude.de;
    return 301 https://$host$request_uri;
}
