# /etc/tts/worker.env (root:tts, mode 640): settings of tts-worker.service and tts-lab.service.
# Every line but WORKER_SECRET is optional (the defaults are shown).

# The relay's worker socket and the secret shared with it (the same value as WORKER_SECRET in the
# relay's .env; at least 16 characters, e.g. `openssl rand -hex 32`).
RELAY_URL=wss://voice.breezedude.de/v1/worker
WORKER_SECRET=
# Shown in the relay's log.
#WORKER_NAME=voicetts

MODEL_DIR=/opt/tts/models
# Public voices (made in the lab), private voices (uploaded from the configurator), clip cache.
VOICE_DIR=/var/lib/tts/voices
PRIVATE_DIR=/var/lib/tts/private
CACHE_DIR=/var/lib/tts/cache/clips
CACHE_MAX_MB=4000

# Model processes (about 7 GB of RAM each) and torch threads per process: one clip is fastest with
# 6 to 8 threads; a second process doubles the throughput only with free cores and memory bandwidth.
ENGINES=1
THREADS=8

# Render the voice pack texts of the public voices into the cache while nobody asks for clips
# (CATALOGUE: node tools/tts-worker/export_catalogue.js > /opt/tts/catalogue.json).
PRERENDER=1
CATALOGUE=/opt/tts/catalogue.json

# The lab (LAN only, no login).
LAB_PORT=7860
